---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Rss from '../resources/svg/rss.astro';
import getReadingTime from 'reading-time';

const posts = await getCollection('blog');

posts.sort((a, b) => {
    return new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime();
});

const formatDate = (date: Date) => {
    return new Date(date).toLocaleDateString('en-gb', { year:"numeric", day:"numeric", month:"short"}).replaceAll(',', '');
};
---

<Layout title="My Blog" description="Hi! I'm Philip. Welcome to my website!">
    <div class="wrapper blog">
        <div class="header">
            <h1 class="title">
                My Blog
                <a href="/blog/rss.xml" class="rss-link" aria-label="RSS Feed"><Rss/> RSS</a>
            </h1>
            <p class="subtitle">Thoughts on Linux, development, and more.</p>
        </div>
        <div class="posts">
            {posts.map((post) => (
                <a href={`/blog/${post.id}`} class="post-card">
                    <div class="post-meta">
                        <span class="date">{formatDate(post.data.pubDate)}</span>
                        <span class="separator">·</span>
                        <span class="reading-time">{getReadingTime(post.body).text}</span>
                    </div>
                    <h2 class="post-title">{post.data.title}</h2>
                    <p class="post-description">{post.data.description}</p>
                    {post.data.tags && (
                        <div class="tags">
                            {post.data.tags.slice(0, 3).map((tag: string) => (
                                <span class="tag">#{tag}</span>
                            ))}
                        </div>
                    )}
                </a>
            ))}
        </div>
    </div>
</Layout>
<style>
    .blog {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    .header {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .blog .title {
        color: var(--primary);
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .blog .title .rss-link {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.9rem;
        color: var(--primary);
        opacity: 0.7;
        transition: opacity 0.2s, color 0.2s;
    }

    .blog .title .rss-link:hover {
        opacity: 1;
        color: var(--accent);
    }

    .subtitle {
        color: var(--primary);
        opacity: 0.6;
        font-size: 1.1rem;
    }

    .blog .posts {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    .post-card {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        padding: 1.25rem;
        background-color: var(--secondary-opacity);
        border: 1px solid var(--primary-opacity);
        border-radius: 0.75rem;
        text-decoration: none;
        transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
    }

    .post-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 20px rgba(0, 136, 255, 0.15);
        border-color: var(--accent);
    }

    .post-meta {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.85rem;
        color: var(--primary);
        opacity: 0.6;
    }

    .separator {
        opacity: 0.4;
    }

    .post-title {
        color: var(--primary);
        font-size: 1.35rem;
        margin: 0;
        transition: color 0.2s;
    }

    .post-card:hover .post-title {
        color: var(--accent);
    }

    .post-description {
        color: var(--primary);
        opacity: 0.75;
        font-size: 0.95rem;
        line-height: 1.5;
        margin: 0;
    }

    .tags {
        display: flex;
        gap: 0.5rem;
        margin-top: 0.25rem;
    }

    .tag {
        font-size: 0.8rem;
        color: var(--accent);
        opacity: 0.7;
    }

    @media only screen and (max-width: 600px) {
        .post-card {
            padding: 1rem;
        }

        .post-title {
            font-size: 1.15rem;
        }
    }
</style>
