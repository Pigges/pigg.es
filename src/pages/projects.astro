---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import * as config from '../config';

---

<Layout title="Projects" description="Hi! I'm Philip. Welcome to my website!">
    <div class="title">
        <h1>Projects</h1>
        <p>
            Below is a list of some of the exciting projects I've been working on recently.
            These projects showcase my commitment to delivering high-quality results.
            I'm always open to collaborating and exploring new ideas.
            If you have a project in mind that aligns with my projects and skills, don't hesitate to get in touch.
        </p>
    </div>
    <section id="projects">
        {config.PROJECTS.map(project=>(
            <div class="project">
                <h2>
                    {project.logo && (
                        <Image src={project.logo} width={24} height={24} alt={project.title} loading="eager" />
                    )}
                    {project.title}
                </h2>
                <p>{project.description}</p>
                {project.notice && (
                    <p class="notice"><em>{project.notice}</em></p>
                )}
                <div class="links">
                    {project.links.map(link=>(
                        <a href={link.href}>{link.title}</a>
                    ))}
                </div>
            </div>
        ))}
    </section>
</Layout>
<style>
    .title {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        margin-bottom: 1.5rem;
    }

    .title > p {
        color: var(--primary);
        opacity: 0.6;
        font-size: 1.1rem;
    }

    #projects {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .project {
        padding: 1rem;
        background: var(--secondary-opacity);
        border: 1px solid var(--primary-opacity);
        border-radius: 0.5rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        transition: border-color 0.2s;
    }

    .project:hover {
        border-color: var(--accent);
    }

    .project h2 {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin: 0;
        font-size: 1rem;
        font-weight: 600;
        color: var(--primary);
    }

    .project p {
        margin: 0;
        color: var(--primary);
        font-size: 0.9rem;
        line-height: 1.5;
        opacity: 0.8;
    }

    .project .notice {
        font-size: 0.85rem;
        opacity: 0.7;
    }

    .project .links {
        display: flex;
        gap: 1rem;
        margin-top: 0.5rem;
    }

    .project .links a {
        color: var(--accent);
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 500;
    }

    .project .links a:hover {
        text-decoration: underline;
    }
</style>
