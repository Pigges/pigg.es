---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
---

<Layout title="404" description="Hi! I'm Philip. Welcome to my website!">
    <div class="not-found">
        <Image class="bug unselectable box glowing rounded" src="/assets/404.svg" alt="bug found" width={300} height={200} />
        <div class="text">
            <h3>404 - Not found</h3>
            <p>Oops! You were not supposed to see this...</p>
        </div>
        <a href="/" class="unselectable btn rounded">Head back home</a>
    </div>
</Layout>
<style>
    .not-found {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 2em;
    }

    .not-found .text {
        text-align: center;
    }

    @media only screen and (max-width: 700px) {
        .bug {
            width: 80%;
        }
    }
</style>