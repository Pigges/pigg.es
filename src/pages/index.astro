---
import Layout from '../layouts/Layout.astro';
import Certificates from '../components/Certificates.astro';
import Hero from '../components/Hero.astro';
import { getCollection } from 'astro:content';

const techStack = [
    { icon: "[L]", name: "Linux" },
    { icon: "[P]", name: "Python" },
    { icon: "[C]", name: "C++" },
    { icon: "[S]", name: "Postgres" },
    { icon: "[M]", name: "MongoDB" },
    { icon: "[D]", name: "Docker" },
    { icon: "[K]", name: "K8s" },
    { icon: "[A]", name: "Astro" },
    { icon: "[T]", name: "TypeScript" },
]

const posts = await getCollection('blog');
const recentPosts = posts
    .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
    .slice(0, 3);

const formatDate = (date: Date) => new Date(date).toLocaleDateString('en-gb', { year:"numeric", month:"short", day:"numeric"}).replace(',', '');
---

<Layout description="Hi! I'm Philip. Welcome to my website!">
    <Hero/>
    <div class="content">
        <div class="left">
            <h2>About</h2>
            <p>I've been fascinated by computers since I was young, always wondering what makes them tick. Now I spend my time building software, exploring Linux, and reading philosophy.</p>
            <p>My main interests lie in system administration and back-end development. I self-host my own services because I care about privacy and keeping control of my own data.</p>
            <a href="/about" class="more">More about me</a>

            <!-- <h2>Tech Stack</h2>
            <div class="tech-grid">
                {techStack.map(tech => (
                    <span class="tech-item">{tech.name}</span>
                ))}
            </div> -->

            <h2>Recent Posts</h2>
            <div class="posts-section">
                <div class="posts">
                    {recentPosts.map(post => (
                        <a href={`/blog/${post.id}`} class="post">
                            <span class="date">{formatDate(post.data.pubDate)}</span>
                            <h3>{post.data.title}</h3>
                        </a>
                    ))}
                </div>
                <a href="/blog" class="more">View all posts</a>
            </div>
        </div>
        <aside>
            <Certificates />
        </aside>
    </div>
</Layout>

<style>
    .content {
        display: grid;
        grid-template-columns: 3fr 1fr;
        gap: 2em;
    }

    h2 {
        font-size: 1.5rem;
        margin: 1rem 0 0.5rem;
        padding-bottom: 0.5rem;
        border-bottom: 2px solid var(--primary-opacity);
        color: var(--primary);
    }

    .tech-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .tech-item {
        padding: 0.5rem 0.75rem;
        background: var(--secondary-opacity);
        border: 1px solid var(--primary-opacity);
        border-radius: 0.5rem;
        font-size: 0.9rem;
    }

    p {
        color: var(--primary);
        line-height: 1.6;
        margin: 0 0 0.75rem;
        opacity: 0.9;
    }

    .more {
        color: var(--accent);
        text-decoration: none;
        font-size: 0.95rem;
    }

    .posts-section {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .posts {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .post {
        padding: 0.75rem 1rem;
        background: var(--secondary-opacity);
        border: 1px solid var(--primary-opacity);
        border-radius: 0.5rem;
        text-decoration: none;
        transition: border-color 0.2s;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .post:hover {
        border-color: var(--accent);
    }

    .post .date {
        font-size: 0.8rem;
        color: var(--primary);
        opacity: 0.6;
    }

    .post h3 {
        margin: 0;
        color: var(--primary);
        font-size: 1rem;
        font-weight: normal;
    }

    @media (max-width: 1000px) {
        .content {
            grid-template-columns: 1fr;
        }
    }
</style>