---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';

import linkedin from '../assets/linkedin.svg';
import github from '../assets/github.svg';
import twitter from '../assets/twitter.svg';
import discord from '../assets/discord.svg';

const links = [
    {
        title: "Linkedin",
        icon: linkedin,
        href: "https://www.linkedin.com/in/philip-ahlqvist-4b93b0250",
    },
    {
        title: "Github",
        icon: github,
        href: "https://github.com/Pigges",
    },
    {
        title: "X (Twitter)",
        icon: twitter,
        href: "https://x.com/Pigges117",
    }
]

---

<Layout title="Link Tree" description="Here is a list of places where you can find me.">
    <div class="wrapper">
        <div class="title">
            <h1>Link Tree</h1>
            <p>Here is a list of places where you can find me.</p>
        </div>
        <div class="links">
            {links.map(link=>(
                <a href={link.href} rel="nofollow" target="_blank" class="link box rounded glowing-hover">
                    <Image src={link.icon} alt={link.title} width="50" />
                    <h3>{link.title}</h3>
                </a>
            ))}
        </div>
    </div>
</Layout>
<style>
    .wrapper {
        display: flex;
        flex-direction: column;
        margin: 0 auto;
        gap: 2em;
    }

    .title {
        text-align: center;
    }

    .links {
        display: flex;
        /* justify-content: center; */
        /* flex-direction: column; */
        flex-flow: row wrap;
        /* width: 750px; */
        /* width: 50%; */
        gap: 2em;
        /* margin: 0 auto; */
    }
    
    .link {
        display: flex;
        align-items: center;
        gap: 1em;
        width: 100%;
        text-decoration: none;
    }
</style>