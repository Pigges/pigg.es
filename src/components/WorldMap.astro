---
import * as d3 from 'd3-geo';
import * as topojson from 'topojson-client';

const countriesVisited = [
  'Sweden',
  'Norway',
  'Denmark'
];

const countriesWantToVisit = [
  'United States of America',
  'Netherlands',
  'Iceland',
  'Canada',
  'United Kingdom',
  'Japan',
  'Australia',
  'New Zealand',
  'Greenland',
  'Mexico',
  'India',
  'Morocco',
  'Poland',
  'France',
  'Italy',
  'Finland',
  'Egypt',
  'Turkey',
  'Czechia',
  'Switzerland',
  'Romania',
  'Vietnam',
];

const response = await fetch('https://cdn.jsdelivr.net/npm/world-atlas@2/countries-110m.json');
const world = await response.json();

const countries = topojson.feature(world, world.objects.countries);

const visitedSet = new Set(countriesVisited);
const wantToVisitSet = new Set(countriesWantToVisit);

const projection = d3.geoMercator()
  .scale(110)
  .translate([350, 355]);

const path = d3.geoPath().projection(projection);

const visited: { d: string; name: string }[] = [];
const wantToVisit: { d: string; name: string }[] = [];
const notVisited: { d: string; name: string }[] = [];

for (const feature of countries.features) {
  if (feature.properties.name === 'Antarctica') continue;
  const d = path(feature) || '';
  if (visitedSet.has(feature.properties.name)) {
    visited.push({ d, name: feature.properties.name });
  } else if (wantToVisitSet.has(feature.properties.name)) {
    wantToVisit.push({ d, name: feature.properties.name });
  } else {
    notVisited.push({ d, name: feature.properties.name });
  }
}
---

<div class="map-container">
  <svg viewBox="0 0 700 500" class="world-map" preserveAspectRatio="xMidYMid meet">
    <defs>
      <clipPath id="mapClip">
        <rect x="0" y="0" width="700" height="500" />
      </clipPath>
    </defs>
    <g clip-path="url(#mapClip)" class="countries">
      {notVisited.map(c => (
        <g class="country-group">
          <path d={c.d} class="country not-visited" />
          <title>{c.name}</title>
        </g>
      ))}
      {wantToVisit.map(c => (
        <g class="country-group">
          <path d={c.d} class="country want-to-visit" />
          <title>{c.name}</title>
        </g>
      ))}
      {visited.map(c => (
        <g class="country-group">
          <path d={c.d} class="country visited" />
          <title>{c.name}</title>
        </g>
      ))}
    </g>
  </svg>
  <div class="legend">
    <span class="legend-item"><span class="dot visited"></span> Visited</span>
    <span class="legend-item"><span class="dot want-to-visit"></span> Want to visit</span>
    <span class="legend-item"><span class="dot not-visited"></span> Not visited</span>
  </div>
</div>

<style>
  .map-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .world-map {
    width: 100%;
    max-width: 800px;
    height: auto;
  }

  @media (max-width: 600px) {
    .world-map {
      width: 100%;
      max-width: none;
    }
    
    .legend {
      flex-direction: column;
      gap: 0.5rem;
      align-items: center;
    }
    
    .country {
      stroke-width: 0.3;
    }
  }

  .country {
    stroke: var(--primary);
    stroke-width: 0.5;
    transition: fill 0.2s;
  }

  .country.not-visited {
    fill: var(--secondary-opacity);
  }

  .country.visited {
    fill: var(--accent);
    opacity: 0.8;
  }

  .country.visited:hover {
    fill: var(--accent);
    opacity: 1;
  }

  .country.want-to-visit {
    fill: #eee;
    opacity: 0.7;
  }

  .country.want-to-visit:hover {
    opacity: 1;
  }

  .legend {
    display: flex;
    gap: 2rem;
    font-size: 0.9rem;
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--primary);
  }

  .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }

  .dot.visited {
    background: var(--accent);
  }

  .dot.want-to-visit {
    background: #eeee;
  }

  .dot.not-visited {
    background: var(--secondary-opacity);
    border: 1px solid var(--primary);
  }
</style>