---
import Badge from './Badge.astro';
import fs from 'node:fs';

const cacheFile = '.certifications.json';

async function fetchCertifications() {
	// Use cache if available for DEV
	if (import.meta.env.DEV && fs.existsSync(cacheFile)) return JSON.parse(fs.readFileSync(cacheFile, 'utf-8'));

	// Fetch Credentials from Credly
	const data = await (await fetch("https://www.credly.com/users/philip-ahlqvist/badges", {
		headers: { "Accept": "application/json" }
	})).json();

	// Save Credentials as cache for DEV
	if (import.meta.env.DEV) fs.writeFileSync(cacheFile, JSON.stringify(data));

	return data;
}

const data = await fetchCertifications();


---

<div id="certificates">
    <h2>Certifications</h2>
    <div class="badges">
      {data.data.map(c=>(
      <Badge id={c.id} name={c.badge_template.name} img={c.badge_template.image_url}/>
      ))}
    </div>
</div>
<style>

	#certificates {
		display: flex;
		flex-direction: column;
		gap: 1em;
	}

	#certificates h2 {
		font-size: 1.5rem;
		margin: 1rem 0 0.5rem;
		padding-bottom: 0.5rem;
		border-bottom: 2px solid var(--primary-opacity);
		color: var(--primary);
	}

	#certificates .badges {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5em;
		width: fit-content;
		transition: 0.2s;
		justify-content: center;
	}

    @media only screen and (max-width: 1000px) {
		#certificates .badges {
			margin: auto;
		}
	}
</style>