---
import HeaderLink from './HeaderLink.astro';
import * as config from '../config';
---

<header class="wrapper rounded">
    <div class="left">
        <a href="/" class="title">Pigg.es</a>
    </div>
    <div class="right">
        <label class="menu" for="menu">
            <input type="checkbox" id="menu">
            <div class="content">
                <svg class="hamburger" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512">
                    <path d="M0 96C0 78.3 14.3 64 32 64H416c17.7 0 32 14.3 32 32s-14.3 32-32 32H32C14.3 128 0 113.7 0 96zM0 256c0-17.7 14.3-32 32-32H416c17.7 0 32 14.3 32 32s-14.3 32-32 32H32c-17.7 0-32-14.3-32-32zM448 416c0 17.7-14.3 32-32 32H32c-17.7 0-32-14.3-32-32s14.3-32 32-32H416c17.7 0 32 14.3 32 32z"/>
                </svg>
                <nav class="links">
                    {config.HEADERLINKS.map(link=>(
                        <HeaderLink href={link.href}>{link.title}</HeaderLink>
                    ))}
                </nav>
            </div>
        </label>
    </div>
</header>
<style>
    header {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        max-width: 1250px;
        min-height: 50px;
        background-color: var(--secondary-opacity);
        margin: auto;
        margin-top: 0.5em;
        left: 50%;
        transform: translateX(-50%);
        border: 1px solid var(--primary-opacity);
        z-index: 10;
    }

    header .left, header .right {
        padding: 0 40px;
    }

    header .right .menu .hamburger {
        display: none;
    }

    header .left .title {
        font-size: 1.5rem;
        font-weight: bold;
        text-decoration: none;
        color: var(--accent);
    }

    header .right {
        display: flex;
        flex-direction: row-reverse;
        align-items: center;
        gap: 20px;
    }

    header .right .menu #menu {
        display: none;
    }

    header .right .menu svg {
        fill: var(--primary);
    }

    header .right .links {
        display: flex;
        gap: 20px;
    }

    @media only screen and (max-width: 1000px) {
        header .left, header .right {
            padding: 0 20px;
        }
    }

    @media only screen and (max-width: 600px) {
        header {
            left: 0;
            transform: none;
            width: 100%;
            box-sizing: border-box;
            border-radius: 0;
            margin: 0;
        }

        header.glowing-hover:hover {
            transform: none;
        }

        header .right .menu .hamburger {
            display: block;
            width: 28px;
            height: 28px;
            cursor: pointer;
        }

        header .right .links {
            display: none;
        }

        header .right .menu {
            display: flex;
            align-self: center;
            cursor: pointer;
        }

        header .right .menu svg {
            transition: transform 0.3s;
        }

        header .right .menu #menu:checked + .content .hamburger {
            transform: rotate(90deg);
        }

        header .right .menu #menu:checked + .content .links {
            display: flex;
            flex-direction: column;
            position: absolute;
            top: 100%;
            left: 0;
            right: 0;
            background-color: var(--secondary);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.4);
            /* border-radius: 0 0 12px 12px; */
            border: 1px solid var(--accent);
            overflow: hidden;
            z-index: 999;
            gap: 0;
            animation: slideDown 0.2s ease-out;
        }

        @keyframes slideDown {
            from {
                opacity: 0;
                transform: translateY(-10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        header .right .menu #menu:checked + .content .links :global(a) {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 16px 20px;
            width: 100%;
            color: var(--primary);
            text-decoration: none;
            font-size: 1.1rem;
            font-weight: 500;
            border-bottom: 1px solid var(--primary-opacity);
            transition: background-color 0.2s, color 0.2s;
            box-sizing: border-box;
        }

        header .right .menu #menu:checked + .content .links :global(a:hover) {
            background-color: var(--accent);
            color: var(--secondary);
        }

        header .right .menu #menu:checked + .content .links :global(a:last-child) {
            border-bottom: none;
        }
    }
</style>