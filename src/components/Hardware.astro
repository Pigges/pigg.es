---
const hardware = [
    {
        device: "Desktop PC",
        specs: [
            "OS: Arch Linux",
            "CPU: AMD Ryzen 7 5700X",
            "GPU: AMD Radeon RX 6750 XT",
            "RAM: 32 GB DDR4 RAM",
        ]
    },
    {
        device: "Laptop",
        specs: [
            "HP ProBook 440 G8",
            "OS: Arch Linux",
            "CPU: Intel Core i5-1135G7",
            "Graphics: NVIDIA GeForce MX450",
            "RAM: 16 GB DDR4",
        ]
    },
    {
        device: "Phone",
        specs: [
            "OnePlus 7 Pro",
            "OS: /e/OS",
            "RAM: 12 GB",
        ]
    },
]
---

<div class="hardware">
    <ul>
        {hardware.map(item => (
            <li>
                <strong>{item.device}</strong>
                <ul>
                    {item.specs.map(spec => (
                        <li>{spec}</li>
                    ))}
                </ul>
            </li>
        ))}
    </ul>
</div>

<style>
    .hardware > ul {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .hardware > ul > li {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .hardware > ul > li > strong {
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--primary);
    }

    .hardware > ul > li > ul {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        padding-left: 1rem;
    }

    .hardware > ul > li > ul > li {
        font-size: 0.9rem;
        line-height: 1.5;
        opacity: 0.8;
    }
</style>
