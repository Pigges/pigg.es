---
// import { Image } from "astro-preload/components";
import { Picture, Image, getImage } from "astro:assets";

export interface Props {
	id: string;
    name: string;
    img: string;
}

const { id, name, img } = Astro.props;
---

<a href={`https://www.credly.com/badges/${id}`} target="_blank" class="badge box glowing-hover rounded">
    <div class="img unselectable">
        <Picture src={img} alt={name} formats={['webp', 'avif', 'jpg']} width="50" height="50"/>
    </div>
    <p class="name">{name}</p>
</a>
<style>
    .badge {
        display: flex;
        gap: 10px;
        align-items: center;
        text-decoration: none;
        width: 100%;
        /* padding: 0.5em;
        border: 1px solid var(--primary-opacity);
        background-color: var(--secondary); */
    }


    .badge picture {
        width: 100%;
    }

    .badge .name {
        font-size: medium;
        max-width: 200px;
    }
</style>
